{
  "name": "after-effects-mcp",
  "version": "2.0.0",
  "description": "MCP server for Adobe After Effects",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external && node scripts/build-cep.mjs",
    "start": "node build/index.js",
    "install-cep": "node scripts/install-cep.mjs",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "ws": "^8.22.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2"
  }
}
